# Keep the build context small: only the Go sources, desktop/frontend sources,
# config.example.yaml and docs/ (bundled by the control panel's Docs page) are needed.

# Git and CI
.git
.github
.gitignore
.goreleaser.yml

# Docker files themselves
Dockerfile
.dockerignore
docker-compose*.yml

# Build output and dependencies
**/node_modules
**/dist
desktop/build/bin
bin
cli-proxy-api
test-output
*.deb
*.rpm

# Runtime data
auths
logs
conv
temp
static
config.yaml
.env
**/*.log

# Development and editor folders
.playwright-mcp
.vscode
.idea
.claude
.codex
.codex-worktrees
.gemini
.serena
.agent
.agents
.antigravitycli
.opencode
.junie
.pi
.worktrees
.bmad
_bmad
_bmad-output
